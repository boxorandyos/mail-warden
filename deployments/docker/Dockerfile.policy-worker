# GO_IMAGE defaults to the toolchain in go.mod. Override to test a newer release.
ARG GO_IMAGE=golang:1.27
FROM ${GO_IMAGE} AS builder
WORKDIR /src

COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -trimpath -ldflags="-s -w" -o /out/policy-worker ./cmd/policy-worker

FROM gcr.io/distroless/static-debian12:nonroot
WORKDIR /app
COPY --from=builder /out/policy-worker /app/policy-worker
ENTRYPOINT ["/app/policy-worker"]
