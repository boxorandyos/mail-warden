[Unit]
Description=Mail Warden API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mailwarden
Group=mailwarden
WorkingDirectory=/opt/mail-warden
EnvironmentFile=/etc/mail-warden/mail-warden.env
ExecStart=/opt/mail-warden/bin/mailwarden -config /opt/mail-warden/configs/mailwarden.yaml -policy-config /opt/mail-warden/configs/policy.yaml
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/mail-warden

[Install]
WantedBy=multi-user.target
